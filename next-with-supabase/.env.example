NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Playwright e2e test accounts (not used by the app itself)
TEST_USER_EMAIL=test.user@test.com
TEST_USER_PASSWORD=test_password
TEST_USER2_EMAIL=test.user2@test.com
TEST_USER2_PASSWORD=test_password2

# Used only by scripts/seed-guides.ts (npm run seed:guides).
SUPABASE_SECRET_KEY=your-privileged-access-key

# OpenRouter API key for server-side LLM calls (lib/ai/openrouter.ts).
# Never prefix with NEXT_PUBLIC_ - this must never reach the browser.
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: point OpenRouter calls at a local mock server for e2e tests
# (see tests/helpers/mock-openrouter-server.mts, npm run mock:openrouter).
# Leave unset to hit the real OpenRouter API (normal dev/prod behavior).
OPENROUTER_MOCK_URL=