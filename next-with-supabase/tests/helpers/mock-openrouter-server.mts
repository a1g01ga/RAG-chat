const server = createServer((req, res) => {
  let body = "";
  req.on("data", (chunk) => {
    body += chunk;
  });
  req.on("end", () => {
    res.setHeader("Content-Type", "application/json");

    if (req.method === "POST" && req.url === "/chat/completions") {
      res.end(JSON.stringify({ choices: [{ message: { content: MOCK_REPLY } }] }));
      return;
    }

    if (req.method === "POST" && req.url === "/embeddings") {
      res.end(JSON.stringify({ data: [{ embedding: PINNED_EMBEDDING }] }));
      return;
    }

    res.statusCode = 404;
    res.end(JSON.stringify({ error: `Unhandled mock route: ${req.method} ${req.url}` }));
  });
});

server.listen(PORT, () => {
  console.log(`Mock OpenRouter server listening on http://localhost:${PORT}`);
});
